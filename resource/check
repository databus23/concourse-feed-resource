#!/usr/bin/env ruby

require 'concourse-fuselage'
require 'open-uri'
require 'rss'

class Check < Fuselage::Check
  def versions
    source["feed"]
    feed = RSS::Parser.parse(URI.open(source["feed"]), false)
    feed.items.map {|entry| {"entry" => entry.id.content}}
  end

  def latest
    versions.first
  end

  def since(version)
    index = versions.index(version)
    return versions if index.nil?
    return [] if index == 0
    versions[0..index-1]
  end
end

unless Check.new.run
  STDERR.puts "Failed to check feed"
  abort
end
